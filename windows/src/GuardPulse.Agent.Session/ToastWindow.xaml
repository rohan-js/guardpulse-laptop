<Window x:Class="GuardPulse.Agent.Session.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Opacity="0">
    <Border Margin="12" Background="#F0181A20" CornerRadius="14" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="18,14,22,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Warning icon badge -->
            <Border Grid.Column="0" Width="52" Height="52" CornerRadius="26" Background="#FFFDF3D8" BorderBrush="#F0B429" BorderThickness="2" VerticalAlignment="Center" Margin="0,0,16,0">
                <TextBlock Text="⚠️" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- White text panel (dark toast shell keeps it readable on any background) -->
            <Border Grid.Column="1" Background="#FFFFFF" CornerRadius="10" Padding="18,12" VerticalAlignment="Center" MaxWidth="460">
                <StackPanel>
                    <TextBlock x:Name="ToastTitle" Text="Screen Time Warning" FontSize="17" FontWeight="Bold" Foreground="#111827" TextWrapping="Wrap"/>
                    <TextBlock x:Name="ToastMessage" Text="You have 5 minutes remaining" FontSize="14" Foreground="#374151" Margin="0,4,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
