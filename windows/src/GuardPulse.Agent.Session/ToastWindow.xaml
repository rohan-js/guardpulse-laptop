<Window x:Class="GuardPulse.Agent.Session.ToastWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        Opacity="0">
    <Border Margin="12" Background="#F0181A20" CornerRadius="12" BorderBrush="#33FFFFFF" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16,12,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Warning / Shield Icon -->
            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Background="#33F59E0B" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="⚠️" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="320">
                <TextBlock x:Name="ToastTitle" Text="Screen Time Warning" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF" TextWrapping="Wrap"/>
                <TextBlock x:Name="ToastMessage" Text="You have 5 minutes remaining" FontSize="12" Foreground="#D1D5DB" Margin="0,3,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
