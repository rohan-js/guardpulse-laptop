<Window x:Class="GuardPulse.Agent.Session.LockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        Focusable="True"
        AllowsTransparency="True"
        Background="Transparent"
        WindowState="Maximized">
    <!-- Digital Pulse lock overlay: frosted full-screen layer + centered glass card -->
    <Border Background="#BFFCF8FB">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    MaxWidth="470" CornerRadius="32" Padding="40"
                    Background="{StaticResource Brush.GlassCardFill}"
                    BorderBrush="{StaticResource Brush.GlassBorder}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="32" ShadowDepth="0" Opacity="0.18" Color="#0058BC"/>
                </Border.Effect>
                <StackPanel>
                    <!-- Lock badge -->
                    <Border Width="64" Height="64" CornerRadius="999"
                            Background="{StaticResource Brush.Primary}"
                            HorizontalAlignment="Center" Margin="0,0,0,32">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" Color="#0058BC"/>
                        </Border.Effect>
                        <TextBlock Text="&#xE72E;" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="32" Foreground="{StaticResource Brush.OnPrimary}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="Access Locked" Style="{StaticResource Text.HeadlineLg}"
                               HorizontalAlignment="Center"/>

                    <!-- Blocked app pill -->
                    <Border CornerRadius="999" Background="#CCF0EDEF"
                            BorderBrush="#4DC1C6D7" BorderThickness="1"
                            Padding="16,6" Margin="0,12,0,12"
                            HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Image x:Name="AppIcon" Width="18" Height="18"
                                   Visibility="Collapsed" VerticalAlignment="Center"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <TextBlock x:Name="AppLabel" Text="" Style="{StaticResource Text.LabelMd}"
                                       Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                       Margin="6,0,0,0" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="ReasonText" Text="Locked by parent" Style="{StaticResource Text.BodyMd}"
                               HorizontalAlignment="Center" Margin="0,0,0,28"/>

                    <!-- Blocked countdown slot (fixed height keeps the layout stable) -->
                    <TextBlock x:Name="BlockedText" Text="" FontSize="14"
                               FontFamily="{StaticResource Font.Sans.SemiBold}"
                               Foreground="{StaticResource Brush.Error}"
                               HorizontalAlignment="Center" Height="22"
                               Visibility="Collapsed"/>

                    <!-- PIN dots -->
                    <StackPanel x:Name="PinRow" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,2,0,12" RenderTransformOrigin="0.5,0.5">
                        <StackPanel.RenderTransform>
                            <TranslateTransform x:Name="PinRowShake" X="0"/>
                        </StackPanel.RenderTransform>
                        <Ellipse x:Name="PinDot0" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse x:Name="PinDot1" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse x:Name="PinDot2" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse x:Name="PinDot3" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse x:Name="PinDot4" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                        <Ellipse x:Name="PinDot5" Width="12" Height="12" Margin="8,0"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2" Fill="Transparent"/>
                    </StackPanel>

                    <!-- Wrong-PIN slot -->
                    <TextBlock x:Name="ErrorText" Text="Wrong PIN. Try again." Height="22"
                               Style="{StaticResource Text.BodyMd}"
                               Foreground="{StaticResource Brush.Error}"
                               HorizontalAlignment="Center" Opacity="0"/>

                    <!-- Keypad -->
                    <UniformGrid x:Name="KeypadGrid" Columns="3" Rows="4" Margin="0,4,0,8">
                        <Button Content="1" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="2" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="3" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="4" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="5" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="6" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="7" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="8" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Content="9" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Style="{StaticResource Button.Keypad}" Click="OnKeyClear"
                                Foreground="{StaticResource Brush.OnSurfaceVariant}">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icons}" FontSize="26"/>
                        </Button>
                        <Button Content="0" Style="{StaticResource Button.Keypad}" Click="OnKeypad"/>
                        <Button Style="{StaticResource Button.Keypad}" Click="OnKeyBack"
                                Foreground="{StaticResource Brush.OnSurfaceVariant}">
                            <TextBlock Text="&#xE750;" FontFamily="{StaticResource Font.Icons}" FontSize="26"/>
                        </Button>
                    </UniformGrid>

                    <TextBlock Text="PHYSICAL KEYBOARD ENTRY ALSO WORKS"
                               Style="{StaticResource Text.LabelSmCaps}" HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <Button x:Name="AskParentButton" Content="Ask Parent to Unlock"
                            Style="{StaticResource Button.Pill}" HorizontalAlignment="Center"
                            Click="OnAskParent"/>

                    <StackPanel x:Name="WaitingPanel" Orientation="Horizontal" HorizontalAlignment="Center"
                                Margin="0,12,0,0" Visibility="Collapsed">
                        <Ellipse Width="14" Height="14" RenderTransformOrigin="0.5,0.5"
                                 Stroke="{StaticResource Brush.Primary}" StrokeThickness="2"
                                 StrokeDashArray="4 4" VerticalAlignment="Center">
                            <Ellipse.RenderTransform>
                                <RotateTransform x:Name="WaitingSpinner"/>
                            </Ellipse.RenderTransform>
                            <Ellipse.Triggers>
                                <EventTrigger RoutedEvent="Loaded">
                                    <BeginStoryboard>
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetName="WaitingSpinner"
                                                             Storyboard.TargetProperty="Angle"
                                                             From="0" To="360" Duration="0:0:1"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Ellipse.Triggers>
                        </Ellipse>
                        <TextBlock x:Name="WaitingText" Text="Waiting for parent approval..."
                                   Style="{StaticResource Text.BodyMd}" Margin="10,0,0,0"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
