<Window x:Class="GuardPulse.Agent.Session.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device Service"
        Width="720" Height="580"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="True">
    <!-- Digital Pulse pairing window: glass surface, custom chrome, bento layout -->
    <Border CornerRadius="12" Background="{StaticResource Brush.GlassFill}"
            BorderBrush="{StaticResource Brush.GlassBorder}" BorderThickness="1"
            Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.15" Color="#1B1B1D"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" x:Name="TitleBar" Height="40" MouseLeftButtonDown="OnTitleBarDrag">
                <Grid>
                    <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="&#xE718;" FontFamily="{StaticResource Font.Icons}"
                                   FontSize="16" Foreground="{StaticResource Brush.Primary}"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text="GuardPulse Laptop" Style="{StaticResource Text.LabelMd}"
                                   Foreground="{StaticResource Brush.OnSurface}"
                                   Margin="8,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <Button x:Name="CloseButton" Width="32" Height="32" HorizontalAlignment="Right"
                            Margin="0,0,8,0" VerticalAlignment="Center" Cursor="Hand"
                            Click="OnClose" Focusable="False">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" CornerRadius="6" Background="Transparent">
                                    <TextBlock Text="&#xE8BB;" FontFamily="{StaticResource Font.Icons}"
                                               FontSize="14" Foreground="{StaticResource Brush.OnSurfaceVariant}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.HoverFill}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>

            <!-- Content -->
            <Grid Grid.Row="1" Margin="40,8,40,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,0,0,24">
                    <TextBlock Text="Pair this laptop with your parent phone"
                               Style="{StaticResource Text.HeadlineLg}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                    <TextBlock Text="Follow the steps below to connect this device to your family account."
                               Style="{StaticResource Text.BodyMd}" HorizontalAlignment="Center"
                               Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>

                <!-- Bento: steps left, pairing visuals right -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="55*"/>
                        <ColumnDefinition Width="45*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Steps card -->
                    <Border Grid.Column="0" CornerRadius="12" Background="#80F0EDEF"
                            BorderBrush="#66FFFFFF" BorderThickness="1" Padding="24"
                            Margin="0,0,12,0" VerticalAlignment="Stretch">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource StepCircle}">
                                    <TextBlock Text="1" Style="{StaticResource Text.LabelMd}"
                                               Foreground="{StaticResource Brush.OnPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Install GuardPulse app" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource Font.Sans.SemiBold}"
                                               Foreground="{StaticResource Brush.OnSurface}"/>
                                    <TextBlock Text="Download the app on your smartphone from the app store."
                                               Style="{StaticResource Text.LabelMd}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Border Style="{StaticResource StepCircle}">
                                    <TextBlock Text="2" Style="{StaticResource Text.LabelMd}"
                                               Foreground="{StaticResource Brush.OnPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Sign in as Parent" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource Font.Sans.SemiBold}"
                                               Foreground="{StaticResource Brush.OnSurface}"/>
                                    <TextBlock Text="Sign in on your phone with your parent account."
                                               Style="{StaticResource Text.LabelMd}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                                <Border Style="{StaticResource StepCircle}">
                                    <TextBlock Text="3" Style="{StaticResource Text.LabelMd}"
                                               Foreground="{StaticResource Brush.OnPrimary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel Margin="16,0,0,0">
                                    <TextBlock Text="Add Device" FontSize="15" FontWeight="SemiBold"
                                               FontFamily="{StaticResource Font.Sans.SemiBold}"
                                               Foreground="{StaticResource Brush.OnSurface}"/>
                                    <TextBlock Text="Tap 'Add Device' and use the camera to scan or enter the code."
                                               Style="{StaticResource Text.LabelMd}" TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Pairing visuals -->
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <Border CornerRadius="12" Background="{StaticResource Brush.SurfaceContainerLowest}"
                                BorderBrush="{StaticResource Brush.GlassBorder}" BorderThickness="1"
                                Padding="24" HorizontalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center">
                                <Image x:Name="QrImage" Width="160" Height="160"
                                       HorizontalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <TextBlock x:Name="DeviceIdText" Text="waiting for service..."
                                           Style="{StaticResource Text.LabelSmCaps}" HorizontalAlignment="Center"
                                           Margin="0,12,0,4" TextTrimming="CharacterEllipsis" MaxWidth="220"
                                           ToolTip="Device ID"/>
                                <TextBlock Text="SCAN WITH PHONE" Style="{StaticResource Text.LabelSmCaps}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border CornerRadius="12" Background="#80E5F1FF"
                                BorderBrush="#1A0058BC" BorderThickness="1"
                                Padding="16" Margin="0,16,0,0">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="PAIRING CODE" Style="{StaticResource Text.LabelSmCaps}"
                                           Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="CodeText" Text="— — —"
                                           FontFamily="{StaticResource Font.Sans.SemiBold}" FontSize="32"
                                           Foreground="{StaticResource Brush.Primary}" HorizontalAlignment="Center"
                                           Margin="0,2,0,0">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="0" ShadowDepth="4" Opacity="0.25" Color="#0058BC"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="2" BorderBrush="{StaticResource Brush.GlassBorder}" BorderThickness="0,1,0,0"
                        Margin="0,24,0,0" Padding="0,16,0,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <Border CornerRadius="999" Background="#80F0EDEF" Padding="16,8"
                                    BorderBrush="#66FFFFFF" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="14" Height="14" RenderTransformOrigin="0.5,0.5"
                                             Stroke="{StaticResource Brush.Primary}" StrokeThickness="2"
                                             StrokeDashArray="4 4" VerticalAlignment="Center">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="WaitingSpinner"/>
                                        </Ellipse.RenderTransform>
                                        <Ellipse.Triggers>
                                            <EventTrigger RoutedEvent="Loaded">
                                                <BeginStoryboard>
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <DoubleAnimation Storyboard.TargetName="WaitingSpinner"
                                                                         Storyboard.TargetProperty="Angle"
                                                                         From="0" To="360" Duration="0:0:1"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </EventTrigger>
                                        </Ellipse.Triggers>
                                    </Ellipse>
                                    <TextBlock x:Name="StatusText" Text="Connecting to service..."
                                               Style="{StaticResource Text.BodyMd}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Opacity="0.7">
                            <TextBlock Text="&#xE7F8;" FontFamily="{StaticResource Font.Icons}" FontSize="16"
                                       Foreground="{StaticResource Brush.OnSurfaceVariant}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="MachineNameText" Text="" Style="{StaticResource Text.LabelMd}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
